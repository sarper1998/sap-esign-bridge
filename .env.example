PORT=8787
BASE_URL=http://localhost:8787

# demo | documenso
SIGNATURE_PROVIDER=demo

# SAP -> SignBridge HMAC. Production'da en az 32 rastgele karakter kullanin.
SAP_WEBHOOK_SECRET=change-this-sap-webhook-secret

# Imza tamamlandiginda SAP'ye geri bildirim (bos birakilirsa demo istemcisi kullanilir)
SAP_UPDATE_URL=
SAP_UPDATE_TOKEN=

# Documenso (SIGNATURE_PROVIDER=documenso iken gerekli)
DOCUMENSO_API_URL=https://app.documenso.com/api/v2
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=

# SAP belge URL'lerini SSRF'e karsi sinirlayin; virgul ile ayirin.
DOCUMENT_HOST_ALLOWLIST=sap.example.com,documents.example.com
